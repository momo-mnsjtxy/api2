{
    "name": "gqink/api",
    "description": "Pure PHP rewrite of the API platform (no ThinkPHP)",
    "type": "project",
    "license": "Apache-2.0",
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.8",
        "jaeger/querylist": "~4.4.0"
    },
    "autoload": {
        "psr-4": {
            "Core\\": "core/",
            "app\\": "app/",
            "think\\": "think/"
        },
        "files": [
            "core/helpers.php",
            "app/common.php"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "optimize-autoloader": true
    }
}
